# Copy to .env.local for local dev. Production/staging values live in hPanel.

# MariaDB (Hostinger Web/Cloud) or MySQL 8. Empty = the app runs on demo data.
# Migrations: npm run db:migrate · demo seed (empty DB only): npm run db:seed
DATABASE_URL=mysql://user:password@host:3306/eatinvietnam
# Pages read restaurants from the DB whenever DATABASE_URL is set. DATA_SOURCE=demo forces the
# built-in demo list instead (stopgap if the DB is broken; /api/health shows which one is live).
DATA_SOURCE=
# Staging only: apply migrations / load demo data when the server starts (see src/db/boot.ts).
MIGRATE_ON_START=
SEED_DEMO_IF_EMPTY=

# Mapbox public token (URL-restricted). Without it /ban-do falls back to the static demo map.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Natural-language search (issue #7)
ANTHROPIC_API_KEY=
NL_SEARCH_MODEL=claude-haiku-5-5

# Cron jobs call /api/cron/<job> with header x-cron-secret
CRON_SECRET=

# Admin (issue #8) — /admin. One account per person; see README "Admin".
# First admins: emails allowed to self-register once at /admin/thiet-lap, plus a code (>= 12 chars)
# the hPanel holder gives them in person. Everyone else is invited from /admin/nguoi-dung.
ADMIN_BOOTSTRAP_EMAILS=
ADMIN_SETUP_CODE=
# >= 32 random characters; encrypts TOTP secrets. Changing it disables everyone's 2FA app.
ADMIN_SECRET_KEY=
# 2FA is required unless this is 0 (staging only, ops decision 09/11).
REQUIRE_ADMIN_2FA=

# Cloudflare R2 (issue #8): photo uploads. R2_PUBLIC_URL = r2.dev link on staging, img.<domain> later.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Only for S3-compatible test servers (CI uses MinIO); leave empty for R2.
R2_ENDPOINT=

# Public site URL, used for canonical / sitemap / OG
NEXT_PUBLIC_SITE_URL=https://eatinvietnam.com
